# Copy to .env for local-only values. Never commit .env or real credentials.
REPOPILOT_ENV=development
REPOPILOT_CONFIG=configs/app.yaml

# Set enabled=true only after provider and model are configured.
LLM_ENABLED=false
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=

EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

RERANKER_ENABLED=false
RERANKER_PROVIDER=
RERANKER_MODEL=
RERANKER_API_KEY=
RERANKER_BASE_URL=

DATABASE_BACKEND=sqlite
DATABASE_URL=sqlite:///./repopilot.db
CHECKPOINTER_BACKEND=sqlite

SANDBOX_BACKEND=local_worktree
SANDBOX_NETWORK_DISABLED=true
SANDBOX_TIMEOUT_SECONDS=300

MAX_LLM_CALLS=30
MAX_TOTAL_TOKENS=100000
MAX_RUNTIME_SECONDS=900
MAX_PATCH_RETRIES=3
MAX_REPLANS=2
MAX_TOOL_RETRIES=2
MAX_TOOL_CALLS=100

LOG_LEVEL=INFO
LOG_FORMAT=json
